           </button>
           <button class="currency-option" data-currency="ZAR" data-symbol="R" role="menuitem">
             <img src="https://flagcdn.com/w20/za.png" alt="ZA Flag" class="currency-flag-img" width="20" height="15">
             <span class="currency-code">ZAR</span>
           </button>
           <button class="currency-option" data-currency="CHF" data-symbol="CHF" role="menuitem">
