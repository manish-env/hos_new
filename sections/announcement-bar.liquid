           </button>
           <button class="currency-option" data-currency="AUD" data-symbol="$" role="menuitem">
             <img src="https://flagcdn.com/w20/au.png" alt="AU Flag" class="currency-flag-img" width="20" height="15">
             <span class="currency-code">AUD</span>
           </button>
           <button class="currency-option" data-currency="AED" data-symbol="د.إ" role="menuitem">
             <img src="https://flagcdn.com/w20/ae.png" alt="AE Flag" class="currency-flag-img" width="20" height="15">
