    </div>
    
         <!-- Hidden Shopify Currency Form -->
     <form id="currency-form" action="/cart/update" method="post" style="display: none;">
       <input type="hidden" name="currency" id="currency-input">
       <input type="hidden" name="return_to" value="{{ request.page_type }}">
