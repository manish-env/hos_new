      "settings": {
        "custom_liquid": "{% style %}\n.hos-privacy{--hos-accent:#f6d7e7;--hos-text:#111;--hos-muted:#666;--hos-border:#e9e9e9;--hos-bg:#fff}\n.hos-privacy *{box-sizing:border-box}\n.hos-privacy{max-width:980px;margin:32px auto;padding:24px;background:var(--hos-bg);border:1px solid var(--hos-border);border-radius:14px}\n.hos-privacy h1,#hos-pp-title{font-size:32px;line-height:1.2;margin:0 0 8px;text-align:left}\n.hos-privacy .subhead{color:var(--hos-muted);font-size:14px;margin-bottom:20px}\n.hos-privacy .badge{display:inline-block;padding:4px 10px;border-radius:999px;background:var(--hos-accent);font-size:12px}\n.hos-privacy .toc{display:grid;grid-template-columns:1fr;gap:8px;border:1px dashed var(--hos-border);padding:14px;border-radius:12px;background:#fafafa;margin:14px 0 24px}\n.hos-privacy .toc a{text-decoration:none;color:var(--hos-text)}\n.hos-privacy .toc a:hover{text-decoration:underline}\n.hos-privacy p{color:var(--hos-text);line-height:1.7;margin:12px 0}\n.hos-privacy ul{padding-left:18px;margin:10px 0 14px}\n.hos-privacy li{margin:6px 0}\n.hos-privacy details{border:1px solid var(--hos-border);border-radius:12px;margin:14px 0;overflow:hidden;background:#fff}\n.hos-privacy summary{cursor:pointer;list-style:none;padding:14px 16px;font-weight:600;position:relative}\n.hos-privacy summary::-webkit-details-marker{display:none}\n.hos-privacy summary:after{content:\"+\";position:absolute;right:16px;top:14px;font-weight:600;color:#333}\n.hos-privacy details[open] summary:after{content:\"–\"}\n.hos-privacy .panel{padding:0 16px 16px;border-top:1px solid var(--hos-border);background:#fff}\n.hos-privacy a{color:#111;text-decoration-color:var(--hos-accent);text-underline-offset:2px}\n.hos-privacy .note{background:linear-gradient(0deg,#fff,#fff) padding-box,repeating-linear-gradient(90deg,var(--hos-accent),var(--hos-accent) 8px,transparent 8px,transparent 16px) border-box;border:1px solid transparent;border-radius:12px;padding:12px 14px;margin:18px 0;color:#222;font-size:14px}\n@media(min-width:960px){\n  .hos-privacy{padding:32px 40px}\n  .hos-privacy .grid{display:grid;grid-template-columns:260px 1fr;gap:28px;align-items:start}\n  .hos-privacy .toc{position:sticky;top:88px}\n}\n{% endstyle %}\n\n<section class=\"hos-privacy page-width\" aria-labelledby=\"hos-pp-title\">\n  <header>\n    <h1 id=\"hos-pp-title\">Privacy Policy</h1>\n    <div class=\"subhead\">\n      <span class=\"badge\">House of Sonali</span>\n      &nbsp; • &nbsp; Last updated: <time datetime=\"2025-08-27\">August 27, 2025</time>\n    </div>\n    <p>\n      At <strong>House of Sonali</strong>, we value your privacy and ensure your shopping experience is secure.\n      This page explains what we collect, how we use it, and the choices you have. By using our site or services,\n      you agree to this policy.\n    </p>\n  </header>\n\n  <div class=\"grid\">\n    <nav class=\"toc\" aria-label=\"Table of contents\">\n      <strong>Quick links</strong>\n      <a href=\"#registration\">Registration</a>\n      <a href=\"#collection\">Personal Information We Collect</a>\n      <a href=\"#update-info\">Access & Update</a>\n      <a href=\"#use\">How We Use Information</a>\n      <a href=\"#sharing\">Sharing with Service Providers</a>\n      <a href=\"#shopify\">Relationship with Shopify</a>\n      <a href=\"#cookies\">Cookies</a>\n      <a href=\"#rights\">Your Rights & Choices</a>\n      <a href=\"#security\">Security & Retention</a>\n      <a href=\"#children\">Children’s Data</a>\n      <a href=\"#intl\">International Transfers</a>\n      <a href=\"#changes\">Changes to this Policy</a>\n      <a href=\"#contact\">Contact</a>\n    </nav>\n\n    <div>\n      <details id=\"registration\" open>\n        <summary>Registration</summary>\n        <div class=\"panel\">\n          <p>To create an account, we require your <strong>email</strong> and <strong>phone number</strong>. Before your first purchase, we’ll also ask for your <strong>name, billing address, and shipping address</strong>.</p>\n        </div>\n      </details>\n\n      <details id=\"collection\">\n        <summary>Personal Information We Collect</summary>\n        <div class=\"panel\">\n          <p>“Personal information” means data that identifies you or can reasonably be linked to you. We may collect:</p>\n          <ul>\n            <li><strong>Contact details</strong>: name, email, phone, billing/shipping addresses</li>\n            <li><strong>Account info</strong>: username, password, preferences</li>\n            <li><strong>Transaction data</strong>: items viewed, cart/wishlist, purchases, returns</li>\n            <li><strong>Communications</strong>: messages you send to our support</li>\n            <li><strong>Device & usage</strong>: IP, browser, device identifiers, interactions</li>\n            <li><strong>Payment</strong>: tokenized payment details handled via secure gateways</li>\n          </ul>\n          <p>We collect information <strong>directly from you</strong>, <strong>automatically</strong> via cookies, and from <strong>service providers/partners</strong> where permitted by law.</p>\n        </div>\n      </details>\n\n      <details id=\"update-info\">\n        <summary>Access, Update, or Delete Your Information</summary>\n        <div class=\"panel\">\n          <p>Use the <strong>“My Account”</strong> area to review or edit most profile details. For sensitive changes or deletion, contact us (see <a href=\"#contact\">Contact</a>). We respond within a reasonable time.</p>\n        </div>\n      </details>\n\n      <details id=\"use\">\n        <summary>How We Use Your Information</summary>\n        <div class=\"panel\">\n          <ul>\n            <li><strong>Provide & improve services</strong>: process payments, fulfill orders, manage your account, enable returns, personalize recommendations</li>\n            <li><strong>Marketing</strong>: send offers and show relevant ads (you can opt out of promotional emails)</li>\n            <li><strong>Security & fraud prevention</strong>: authenticate accounts; detect and act on suspicious activity</li>\n            <li><strong>Support & communications</strong>: respond to questions and maintain our relationship with you</li>\n            <li><strong>Legal</strong>: comply with laws and enforce our terms</li>\n          </ul>\n          <div class=\"note\">We never sell your personal information. We share it only as described below to operate our business.</div>\n        </div>\n      </details>\n\n      <details id=\"sharing\">\n        <summary>Information Sharing with Service Providers</summary>\n        <div class=\"panel\">\n          <p>We use trusted providers (payment gateways, shipping/logistics, IT & analytics, customer support). We share only what’s necessary and require them to protect your data and use it solely for House of Sonali. We may disclose information when required by law or to protect rights and safety.</p>\n        </div>\n      </details>\n\n      <details id=\"shopify\">\n        <summary>Relationship with Shopify</summary>\n        <div class=\"panel\">\n          <p>Our store is hosted on Shopify. Shopify processes some data to provide and improve services for merchants and customers (hosting, payments, security, analytics, personalized advertising across merchants).</p>\n          <p>Learn more at the <a href=\"https://www.shopify.com/legal/privacy/app-users\" target=\"_blank\" rel=\"noopener\">Shopify Consumer Privacy Policy</a> and <a href=\"https://privacy.shopify.com/en\" target=\"_blank\" rel=\"noopener\">Shopify Privacy Portal</a>. Opt out of data-sharing for targeted ads (where available) here: <a href=\"/pages/data-sharing-opt-out\">Data-Sharing Opt-Out</a>.</p>\n        </div>\n      </details>\n\n      <details id=\"cookies\">\n        <summary>Cookie Policy</summary>\n        <div class=\"panel\">\n          <p>We use cookies to remember preferences, keep sessions secure, measure performance, and personalize content/ads. You can control cookies in your browser; some features may not work without them.</p>\n          <ul>\n            <li><strong>Authentication & security</strong></li>\n            <li><strong>Preferences & features</strong></li>\n            <li><strong>Analytics & performance</strong></li>\n            <li><strong>Advertising</strong> (interest-based ads where permitted)</li>\n          </ul>\n        </div>\n      </details>\n\n      <details id=\"rights\">\n        <summary>Your Rights & Choices</summary>\n        <div class=\"panel\">\n          <p>Depending on your region, you may have rights to <strong>access</strong>, <strong>delete</strong>, <strong>correct</strong>, or <strong>port</strong> your data; and to <strong>opt out</strong> of targeted advertising or data “sharing.” Use in-site controls where available, our <a href=\"/pages/data-sharing-opt-out\">opt-out page</a>, or contact us below.</p>\n          <p><strong>EEA/UK users:</strong> You may also object to or restrict processing and withdraw consent where relied upon. Supervisory authorities: <a href=\"https://edpb.europa.eu/about-edpb/about-edpb/members\" target=\"_blank\" rel=\"noopener\">see list</a>.</p>\n          <p>If your browser sends a supported Global Privacy Control (GPC) signal, we treat it as an opt-out for that browser/device (and your account, where we can associate it).</p>\n        </div>\n      </details>\n\n      <details id=\"security\">\n        <summary>Security & Retention</summary>\n        <div class=\"panel\">\n          <p>We use TLS for data in transit, secure servers, and access controls. No method is 100% secure; avoid sending sensitive data over unsecure channels. We retain data as long as needed to provide services, comply with law, resolve disputes, and enforce agreements.</p>\n        </div>\n      </details>\n\n      <details id=\"children\">\n        <summary>Children’s Data</summary>\n        <div class=\"panel\">\n          <p>Our services are not intended for children under the age of majority. We do not knowingly collect their data. If you believe a child has provided information, contact us to delete it.</p>\n        </div>\n      </details>\n\n      <details id=\"intl\">\n        <summary>International Transfers</summary>\n        <div class=\"panel\">\n          <p>Your information may be processed outside your country. For EEA/UK transfers, we rely on safeguards such as Standard Contractual Clauses where required.</p>\n        </div>\n      </details>\n\n      <details id=\"changes\">\n        <summary>Changes to this Policy</summary>\n        <div class=\"panel\">\n          <p>We may update this policy to reflect changes in our practices or for legal reasons. We’ll update the “Last updated” date and provide additional notice where required.</p>\n        </div>\n      </details>\n\n      <details id=\"contact\">\n        <summary>Contact</summary>\n        <div class=\"panel\">\n          <p>Questions or requests?</p>\n          <ul>\n            <li>Email: <a href=\"mailto:support@houseofsonali.com\">support@houseofsonali.com</a></li>\n            <li>Alternate: <a href=\"mailto:manishbsn188@gmail.com\">manishbsn188@gmail.com</a></li>\n          </ul>\n          <p>For data protection purposes, <strong>House of Sonali</strong> is the data controller.</p>\n        </div>\n      </details>\n    </div>\n  </div>\n</section>",
